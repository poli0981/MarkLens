# Normalize to LF in the repository. The dev machine is Windows and the golden
# / integration runners are Ubuntu; without this, line endings differ between
# them and goldens flap.
* text=auto eol=lf

# ── Byte-exact test fixtures ──────────────────────────────────────────────
# docs/12_TESTING.md requires fixtures with CRLF line endings, a UTF-8 BOM and
# deliberately malformed UTF-8. If git normalizes those, the tests asserting on
# them silently become no-ops while still passing — so this one directory is
# opaque to git and the bytes on disk are the bytes in the repo.
#
# Scoped to bytes/ rather than the whole corpus on purpose: the GFM and MDX
# pages are ordinary text, and marking them binary would cost their diffs for
# no benefit.
test/fixtures/torture/bytes/** -text

# ── Binary assets ─────────────────────────────────────────────────────────
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.bmp  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary

# ── Platform scripts keep their native endings ────────────────────────────
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf

# ── Language stats: keep the vendored license out of the language bar ─────
LICENSE linguist-vendored
