{
  "@@locale": "en",
  "appTitle": "MarkLens",
  "@appTitle": {
    "description": "Application name. Window title and About screen."
  },
  "menuFile": "&File",
  "@menuFile": {
    "description": "Menu bar: File menu label. The '&' marks the Alt accelerator letter and is stripped before display (MenuAcceleratorLabel)."
  },
  "menuView": "&View",
  "@menuView": {
    "description": "Menu bar: View menu label. '&' marks the Alt accelerator letter."
  },
  "menuHelp": "&Help",
  "@menuHelp": {
    "description": "Menu bar: Help menu label. '&' marks the Alt accelerator letter."
  },
  "menuOpenFiles": "Open File(s)…",
  "@menuOpenFiles": {
    "description": "File menu: open one or more documents."
  },
  "menuOpenFolder": "Open Folder…",
  "@menuOpenFolder": {
    "description": "File menu: open a folder of documents."
  },
  "readerCopyCodeTooltip": "Copy code",
  "@readerCopyCodeTooltip": {
    "description": "Tooltip on the copy button of a fenced code block."
  },
  "sidebarMissingBadge": "missing",
  "@sidebarMissingBadge": {
    "description": "Sidebar badge on a file that no longer exists on disk."
  },
  "readerRawHtmlTitle": "Raw HTML (not rendered)",
  "@readerRawHtmlTitle": {
    "description": "Title of the collapsed box holding block HTML. MarkLens never renders HTML (docs/04)."
  },
  "readerMdxImportsHidden": "MDX · {count, plural, =1{1 import hidden} other{{count} imports hidden}}",
  "@readerMdxImportsHidden": {
    "description": "Chip in the document header when the MDX sanitizer removed ESM import/export lines.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "readerMdxComponentTitle": "{name} (MDX component, not rendered)",
  "@readerMdxComponentTitle": {
    "description": "Title of the collapsed placeholder card standing in for an MDX component. Render, not run (docs/04).",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Callout"
      }
    }
  },
  "readerMdxComponentAttributes": "Attributes: {names}",
  "@readerMdxComponentAttributes": {
    "description": "Tooltip over the attribute-name summary on an MDX placeholder card.",
    "placeholders": {
      "names": {
        "type": "String",
        "example": "type title"
      }
    }
  },
  "readerLinkUnsupported": "MarkLens doesn’t open {kind} links.",
  "@readerLinkUnsupported": {
    "description": "Notice after clicking a link that is neither http(s) nor a document MarkLens opens. Never followed (docs/10).",
    "placeholders": {
      "kind": {
        "type": "String",
        "example": "javascript"
      }
    }
  },
  "readerLinkMissingTarget": "{name} isn’t there any more.",
  "@readerLinkMissingTarget": {
    "description": "Notice after clicking a relative link whose target file does not exist.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "ARCHITECTURE.md"
      }
    }
  },
  "readerLinkMissingAnchor": "No heading matches #{anchor}.",
  "@readerLinkMissingAnchor": {
    "description": "Notice after clicking an anchor link with no matching heading slug (docs/04).",
    "placeholders": {
      "anchor": {
        "type": "String",
        "example": "getting-started"
      }
    }
  },
  "readerLinkLaunchFailed": "Couldn’t hand {host} to the browser.",
  "@readerLinkLaunchFailed": {
    "description": "Notice when the platform refused to open an external URL.",
    "placeholders": {
      "host": {
        "type": "String",
        "example": "example.com"
      }
    }
  },
  "emptyStateDropHint": "Drop a Markdown file here, or open one to begin.",
  "@emptyStateDropHint": {
    "description": "First-run empty state, shown when nothing is open."
  },
  "menuOpenRecent": "Open Recent",
  "@menuOpenRecent": {
    "description": "File menu: submenu of recently opened documents."
  },
  "menuOpenRecentEmpty": "No recent documents",
  "@menuOpenRecentEmpty": {
    "description": "Placeholder inside the Open Recent submenu when it is empty."
  },
  "menuReload": "Reload",
  "@menuReload": {
    "description": "File menu: re-read the active document from disk."
  },
  "menuCopyDocument": "Copy entire document",
  "@menuCopyDocument": {
    "description": "File menu: copy the whole Markdown source to the clipboard (docs/06)."
  },
  "menuCloseTab": "Close Tab",
  "@menuCloseTab": {
    "description": "File menu: close the active tab."
  },
  "menuCloseAll": "Close All",
  "@menuCloseAll": {
    "description": "File menu: close every open tab."
  },
  "menuSettings": "Settings…",
  "@menuSettings": {
    "description": "File menu: open the settings screen."
  },
  "menuExit": "Exit",
  "@menuExit": {
    "description": "File menu: quit MarkLens."
  },
  "menuToggleSidebar": "Toggle Sidebar",
  "@menuToggleSidebar": {
    "description": "View menu: show or hide the file sidebar."
  },
  "menuToggleOutline": "Toggle Outline",
  "@menuToggleOutline": {
    "description": "View menu: show or hide the outline panel."
  },
  "menuZoomIn": "Zoom In",
  "@menuZoomIn": {
    "description": "View menu: increase the reading zoom."
  },
  "menuZoomOut": "Zoom Out",
  "@menuZoomOut": {
    "description": "View menu: decrease the reading zoom."
  },
  "menuZoomReset": "Reset Zoom",
  "@menuZoomReset": {
    "description": "View menu: return the reading zoom to 100%."
  },
  "menuTheme": "Theme",
  "@menuTheme": {
    "description": "View menu: submenu choosing the colour theme."
  },
  "menuThemeSystem": "System",
  "@menuThemeSystem": {
    "description": "Theme submenu: follow the operating system setting."
  },
  "menuThemeLight": "Light",
  "@menuThemeLight": {
    "description": "Theme submenu: always light."
  },
  "menuThemeDark": "Dark",
  "@menuThemeDark": {
    "description": "Theme submenu: always dark."
  },
  "menuFullScreen": "Full Screen",
  "@menuFullScreen": {
    "description": "View menu: enter or leave full screen."
  },
  "menuCheckUpdates": "Check for Updates…",
  "@menuCheckUpdates": {
    "description": "Help menu: ask GitHub whether a newer release exists."
  },
  "menuThirdPartyLicenses": "Third-party Licenses",
  "@menuThirdPartyLicenses": {
    "description": "Help menu: show the bundled dependency licences."
  },
  "menuExportLog": "Export Diagnostic Log…",
  "@menuExportLog": {
    "description": "Help menu: write the in-memory log to a file the user picks."
  },
  "menuAbout": "About MarkLens",
  "@menuAbout": {
    "description": "Help menu: version and project information."
  },
  "menuNotImplemented": "{item} is not wired up yet",
  "@menuNotImplemented": {
    "description": "Snackbar shown when a prototype menu item has no behaviour yet.",
    "placeholders": {
      "item": {
        "type": "String",
        "example": "Open Folder…"
      }
    }
  },
  "readerNoticeInvalidUtf8": "This file is not valid UTF-8. Some characters were replaced.",
  "@readerNoticeInvalidUtf8": {
    "description": "Notice bar for DocNoticeKind.invalidUtf8 (docs/04 stage 1)."
  },
  "readerNoticeFrontMatterUnparsed": "The front matter is not simple key/value lines, so it is shown as written.",
  "@readerNoticeFrontMatterUnparsed": {
    "description": "Notice bar for DocNoticeKind.frontMatterUnparsed (docs/04 stage 2)."
  },
  "readerNoticeMdxBailOut": "Some MDX could not be interpreted and is shown as source.",
  "@readerNoticeMdxBailOut": {
    "description": "Notice bar for DocNoticeKind.mdxBailOut. Bailing out is correct behaviour, not an error (docs/04)."
  },
  "readerNoticePlainTextFallback": "This document could not be parsed and is shown as plain text.",
  "@readerNoticePlainTextFallback": {
    "description": "Notice bar for DocNoticeKind.plainTextFallback (CLAUDE.md rule 9)."
  },
  "readerNoticeLargeDocument": "This is a large document. Some features may be slower than usual.",
  "@readerNoticeLargeDocument": {
    "description": "Notice bar for DocNoticeKind.largeDocument, over the 10 MB threshold (docs/04)."
  },
  "readerCopied": "Copied",
  "@readerCopied": {
    "description": "Tooltip on the code copy button just after it was used."
  },
  "readerExpand": "Expand",
  "@readerExpand": {
    "description": "Tooltip on the control that opens the collapsed raw-HTML box."
  },
  "readerCollapse": "Collapse",
  "@readerCollapse": {
    "description": "Tooltip on the control that closes the raw-HTML box."
  },
  "readerFrontMatterTitle": "Front matter",
  "@readerFrontMatterTitle": {
    "description": "Header of the collapsible panel holding a document's leading --- block (docs/04)."
  },
  "readerNoticeDismiss": "Dismiss",
  "@readerNoticeDismiss": {
    "description": "Tooltip on the notice bar's close button."
  },
  "readerNoticeMore": "{count, plural, =1{1 more notice} other{{count} more notices}}",
  "@readerNoticeMore": {
    "description": "Shown beside a notice when a document raised more than one.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "readerOpenFailed": "{name} could not be opened.",
  "@readerOpenFailed": {
    "description": "Snackbar when a chosen file cannot be read at all.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "README.md"
      }
    }
  },
  "sidebarEmpty": "No documents open.",
  "@sidebarEmpty": {
    "description": "Sidebar placeholder before anything has been opened."
  },
  "sidebarPin": "Pin",
  "@sidebarPin": {
    "description": "Sidebar row menu: keep this document at the left of the tab strip."
  },
  "sidebarUnpin": "Unpin",
  "@sidebarUnpin": {
    "description": "Sidebar row menu: stop pinning this document."
  },
  "openFolderCapTitle": "That folder holds more than {count} documents",
  "@openFolderCapTitle": {
    "description": "Dialog title when a folder scan hits the soft cap (docs/07).",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "1000"
      }
    }
  },
  "openFolderCapBody": "MarkLens can open the first {count} of them. Opening the rest would make the sidebar and the session slower than they are worth.",
  "@openFolderCapBody": {
    "description": "Dialog body for the folder cap.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "1000"
      }
    }
  },
  "openFolderCapAccept": "Open first {count}",
  "@openFolderCapAccept": {
    "description": "Confirm button for the folder cap dialog.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "1000"
      }
    }
  },
  "commonCancel": "Cancel",
  "@commonCancel": {
    "description": "Generic cancel button."
  },
  "sessionNotRestored": "The previous session could not be read. It has been kept alongside a fresh one.",
  "@sessionNotRestored": {
    "description": "Snackbar when session.json was corrupt or written by a newer version (docs/05)."
  },
  "statusBarPosition": "{percent}%",
  "@statusBarPosition": {
    "description": "Status bar: how far through the document the reader has scrolled (docs/06).",
    "placeholders": {
      "percent": {
        "type": "int",
        "example": "42"
      }
    }
  },
  "statusBarWordCount": "{count, plural, =1{1 word} other{{count} words}}",
  "@statusBarWordCount": {
    "description": "Status bar: words in the document, fenced code excluded (docs/06). Each CJK character counts as one word.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "1240"
      }
    }
  },
  "statusBarNotices": "{count, plural, =1{1 notice} other{{count} notices}}",
  "@statusBarNotices": {
    "description": "Status bar: how many parse notices the document raised (docs/06). Hidden when there are none.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "statusBarNoDocument": "No document open",
  "@statusBarNoDocument": {
    "description": "Status bar when nothing is open, in place of path/position/word count."
  },
  "outlinePanelTitle": "Outline",
  "@outlinePanelTitle": {
    "description": "Heading of the outline panel beside the reader (docs/06)."
  },
  "settingsNotRestored": "Your settings could not be read. They have been kept alongside fresh defaults.",
  "@settingsNotRestored": {
    "description": "Snackbar when settings.json was corrupt or written by a newer version (docs/05)."
  },
  "outlineEmpty": "This document has no headings.",
  "@outlineEmpty": {
    "description": "Outline panel when the document has no headings at all (docs/06). Not an error."
  },
  "findPlaceholder": "Find in document",
  "@findPlaceholder": {
    "description": "Placeholder in the find bar's query field (docs/08)."
  },
  "findMatchCounter": "{current}/{total}",
  "@findMatchCounter": {
    "description": "Find bar: which match you are on, out of how many (docs/08).",
    "placeholders": {
      "current": {
        "type": "int",
        "example": "3"
      },
      "total": {
        "type": "int",
        "example": "17"
      }
    }
  },
  "findNoResults": "No matches",
  "@findNoResults": {
    "description": "Find bar counter when the query matches nothing."
  },
  "findCaseSensitive": "Match case",
  "@findCaseSensitive": {
    "description": "Find bar: tooltip on the case-sensitivity toggle."
  },
  "findNext": "Next match",
  "@findNext": {
    "description": "Find bar: tooltip on the next-match arrow (Enter)."
  },
  "findPrevious": "Previous match",
  "@findPrevious": {
    "description": "Find bar: tooltip on the previous-match arrow (Shift+Enter)."
  },
  "findClose": "Close find",
  "@findClose": {
    "description": "Find bar: tooltip on the close button (Esc)."
  }
}
